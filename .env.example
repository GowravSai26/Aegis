GROQ_API_KEY=
# Groq model used by all five agents (llama-3.x models were retired in Aug 2026)
GROQ_MODEL=openai/gpt-oss-120b
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=aegis
ENVIRONMENT=development
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=https://aegis-zeta-ten.vercel.app,http://localhost:5500
